{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "build",
  "autoupdate": true,
  "share": "manual",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny"
    },
    "bash": {
      "*": "ask",
      "cat .env": "deny",
      "cat *.env": "deny"
    },
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
